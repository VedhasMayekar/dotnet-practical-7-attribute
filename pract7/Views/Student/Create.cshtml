@model pract7.Models.Student
@{
    ViewData["Title"] = "Create a Student";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 720px; margin: 40px auto; padding: 0 18px; }
        label { display: block; margin-top: 14px; }
        input { padding: 8px; width: 100%; max-width: 400px; }
        button { margin-top: 20px; padding: 10px 18px; cursor: pointer; }
    </style>
</head>
<body>
    <h2>@ViewData["Title"]</h2>
    <h3>@ViewBag.Greetings</h3>

    <form asp-controller="Student" asp-action="Create" method="post">
        <div>
            <label asp-for="Id"></label>
            <input asp-for="Id" />
        </div>
        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" />
        </div>
        <div>
            <label asp-for="Course"></label>
            <input asp-for="Course" />
        </div>
        <button type="submit">Submit Details</button>
    </form>
</body>
</html>
